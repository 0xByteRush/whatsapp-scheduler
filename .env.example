# Copy to .env and adjust. Every setting is optional unless noted.

# How messages go out:
#   baileys (default) - its own linked-device session; headless, groups, delivery receipts
#   desktop           - drives the WhatsApp Desktop app on this Windows PC (needs Windows unlocked)
SENDER=baileys

# Time zone for scheduling and repeats (IANA name).
TZ=Asia/Riyadh

# Web server. Keep HOST=127.0.0.1 unless a reverse proxy/Docker sits in front.
HOST=127.0.0.1
PORT=3737

# Required whenever HOST is not 127.0.0.1/localhost. At least 10 characters.
ADMIN_PASSWORD=

# Extra hostnames allowed to reach the app (e.g. your domain behind a reverse proxy).
ALLOWED_HOSTS=
# Set to 1 when behind a reverse proxy that sets X-Forwarded-* (enables Secure cookies over HTTPS).
TRUST_PROXY=0

# Where the SQLite database (messages + WhatsApp session) lives.
DATA_DIR=./data

# Push alerts when WhatsApp disconnects/unlinks or a message fails.
# Pick a hard-to-guess topic and subscribe to it in the ntfy app, e.g. https://ntfy.sh/your-random-topic
ALERT_NTFY_URL=

# Sending behaviour
MISSED_GRACE_MINUTES=60
MAX_ATTEMPTS=3
MIN_SEND_GAP_MS=4000
DAILY_SEND_LIMIT=200

LOG_LEVEL=info
